# Copy to terraform.tfvars (git-ignored) and fill in real values.
# All values below are FAKE placeholders.

org_id          = "123456789012"
billing_account = "000000-000000-000000"
prefix          = "acme"

# Only set when the derived seed project ID (<prefix>-iac-seed) is taken globally.
# seed_project_id_suffix = "-x1"

# region = "us-central1"

# Globally unique.
state_bucket_name = "acme-iac-tfstate"

devops_principal = "group:gcp-devops@example.com"
admin_principals = ["group:gcp-admins@example.com"]

# Set after the first apply, once the admins group is seed project owner.
# seed_creator_principal = "user:admin1@example.com"

billing_viewer_principals = ["group:gcp-billing@example.com"]
trigger_admin_principals  = ["group:gcp-admins@example.com"]

# ---------------------------------------------------------------------------
# GitHub part: first apply with enable_github = false; after building/pushing the
# builder image and creating the GitHub connection in the Console, set true.
# ---------------------------------------------------------------------------
enable_github = false

# builder_image          = "us-central1-docker.pkg.dev/acme-iac-seed/iac-builder/tofu:1.13.1"
# github_connection_name = "github"
# github_repo_uri        = "https://github.com/acme/cloud-ops.git"

# Scheduled drift/coverage checks (Cloud Scheduler -> <stage>-check triggers). Defaults shown.
# check_schedule  = "0 3 * * *"
# check_time_zone = "Asia/Taipei"
