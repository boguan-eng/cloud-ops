# Copy to terraform.tfvars (git-ignored) and fill in real values.
# All values below are FAKE placeholders.

org_id          = "123456789012"
billing_account = "000000-000000-000000"
prefix          = "acme"

# Only set when the derived project ID (<prefix>-app-<env>) is taken globally.
# project_id_suffix = "-x1"

group_devops     = "gcp-devops@example.com"
group_developers = "gcp-developers@example.com"
group_approvers  = "gcp-approvers@example.com"

pam_approver_emails = ["pam-approver@example.com"]
pam_admin_emails    = ["pam-admin@example.com"]

# Project-tier IaC service accounts (stage 0 output `service_accounts`).
iac_project_plan_sa  = "iac-project-plan@acme-iac-seed.iam.gserviceaccount.com"
iac_project_apply_sa = "iac-project-apply@acme-iac-seed.iam.gserviceaccount.com"

# The stage 2 apply SA (stage 0 output `service_accounts`, key org-apply); its auto-granted
# roles/owner on the env projects is removed (owner-cleanup.tf).
iac_org_apply_sa = "iac-org-apply@acme-iac-seed.iam.gserviceaccount.com"

# ---------------------------------------------------------------------------
# Optional overrides. Defaults live in variables.tf. Uncomment to override;
# an override REPLACES the whole default list (list every role you want to keep).
# ---------------------------------------------------------------------------

